# Line endings: normalise text to LF in the repo and on checkout.
# Later rules win, so keep the synced-config block last.
* text=auto eol=lf

# Windows scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Text types in this repo, with diff hunk headers where git has a driver.
*.py text diff=python
*.md text diff=markdown
*.sh text eol=lf diff=bash
*.bats text eol=lf diff=bash
*.yml text
*.yaml text
*.json text
*.toml text
*.conf text
*.ini text
*.ps1 text eol=crlf

# Binary files: never convert or diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Bootstrap scripts are fetched raw (irm | iex, curl | bash): LF in the repo and in checkouts.
get.ps1 text eol=lf
get.sh text eol=lf

# Synced config: keep exact bytes (last, so these win over the rules above).
dot-claude/** -text
dot-agents/** -text
memory/** -text
